# Required only for the `aeo` module (answer-engine visibility testing).
# All other modules run with zero credentials against public data.
ANTHROPIC_API_KEY=

# Optional. Overrides the default crawler User-Agent.
# Keep it honest and contactable - this tool identifies itself on every request.
RECON_USER_AGENT="acquisition-recon/0.1 (+https://github.com/<you>/acquisition-recon)"
